rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra padrão de bloqueio global
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== FUNÇÕES AUXILIARES ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function temPerfil() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ativo() {
      return temPerfil() && perfil().ativo == true;
    }

    // Admin usado conjuntamente por Financeiro e Coordenação
    function admin() {
      return (ativo() && perfil().role in ['admin', 'financeiro']) ||
        (isSignedIn() && request.auth.token.email == 'blabluki@gmail.com' && request.auth.token.email_verified == true);
    }

    function equipe() {
      return ativo() && (perfil().role == 'admin' || perfil().role == 'operador' || perfil().role == 'financeiro');
    }

    function eNota() {
      return ativo() && perfil().role == 'vistoria_nota';
    }

    // Vistoriador AMETA – Comprovantes
    function eComp() {
      return ativo() && perfil().role == 'vistoria_ameta';
    }

    function interno() {
      return admin() || equipe() || eNota() || eComp();
    }

    function acessoFluxoEquipes() {
      return admin() || eNota() || eComp();
    }

    // ==================== VALIDADORES DE SCHEMA ====================
    function isValidUsuario(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'ativo']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'cpfCnpj', 'phone', 'role', 'ativo', 'isFirstLogin', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        data.role in ['admin', 'operador', 'financeiro', 'vistoria_nota', 'vistoria_ameta'] &&
        data.ativo is bool &&
        (!('cpfCnpj' in data) || (data.cpfCnpj is string && data.cpfCnpj.size() <= 30)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('isFirstLogin' in data) || data.isFirstLogin is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    // Validação estrita dos EXATOS 16 campos do formulário público + metadados de sistema
    function isValidCadastroPublicoCreate(data) {
      return data.keys().hasAll([
          'nome', 'cpf', 'rg', 'dataNascimento', 'filiacaoMae', 'filiacaoPai',
          'funcao', 'empresa', 'cnpj', 'telefone', 'email', 'cep',
          'endereco', 'cidadeUf', 'dadosBancarios', 'chavePix',
          'status', 'criadoEm'
        ]) &&
        data.keys().hasOnly([
          'nome', 'cpf', 'rg', 'dataNascimento', 'filiacaoMae', 'filiacaoPai',
          'funcao', 'empresa', 'cnpj', 'telefone', 'email', 'cep',
          'endereco', 'cidadeUf', 'dadosBancarios', 'chavePix',
          'status', 'criadoEm'
        ]) &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 150 &&
        data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 20 &&
        data.rg is string && data.rg.size() >= 4 && data.rg.size() <= 30 &&
        data.dataNascimento is string && data.dataNascimento.size() >= 8 && data.dataNascimento.size() <= 20 &&
        data.filiacaoMae is string && data.filiacaoMae.size() >= 2 && data.filiacaoMae.size() <= 150 &&
        data.filiacaoPai is string && data.filiacaoPai.size() <= 150 &&
        data.funcao is string && data.funcao.size() >= 2 && data.funcao.size() <= 120 &&
        data.empresa is string && data.empresa.size() >= 2 && data.empresa.size() <= 180 &&
        data.cnpj is string && data.cnpj.size() >= 14 && data.cnpj.size() <= 25 &&
        data.telefone is string && data.telefone.size() >= 8 && data.telefone.size() <= 30 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 180 &&
        data.cep is string && data.cep.size() >= 8 && data.cep.size() <= 15 &&
        data.endereco is string && data.endereco.size() >= 4 && data.endereco.size() <= 250 &&
        data.cidadeUf is string && data.cidadeUf.size() >= 3 && data.cidadeUf.size() <= 100 &&
        data.dadosBancarios is string && data.dadosBancarios.size() >= 4 && data.dadosBancarios.size() <= 200 &&
        data.chavePix is string && data.chavePix.size() >= 3 && data.chavePix.size() <= 150 &&
        data.status == 'Pendente' &&
        data.criadoEm == request.time;
    }

    function isValidCadastroUpdate(data) {
      return data.status in ['Pendente', 'Em andamento', 'Concluído'] &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 150 &&
        (!('concluidoPorUid' in data) || (data.concluidoPorUid is string && data.concluidoPorUid.size() <= 128)) &&
        (!('concluidoPorNome' in data) || (data.concluidoPorNome is string && data.concluidoPorNome.size() <= 150));
    }

    function isValidNota(data) {
      return data.keys().hasAll([
          'prestadorId', 'prestadorNome', 'prestadorCnpj', 'numero', 'dataEmissao',
          'valor', 'descricao', 'status', 'criadoPorUid', 'criadoPorNome', 'criadoEm', 'atualizadoEm'
        ]) &&
        data.keys().hasOnly([
          'prestadorId', 'prestadorNome', 'prestadorCnpj', 'prestadorEmpresa', 'prestadorFuncao',
          'numero', 'dataEmissao', 'valor', 'descricao', 'observacoes',
          'arquivoPath', 'arquivoNome', 'status', 'criadoPorUid', 'criadoPorNome', 'criadoEm', 'atualizadoEm'
        ]) &&
        isValidId(data.prestadorId) &&
        data.prestadorNome is string && data.prestadorNome.size() >= 2 && data.prestadorNome.size() <= 150 &&
        data.prestadorCnpj is string && data.prestadorCnpj.size() >= 14 && data.prestadorCnpj.size() <= 25 &&
        data.numero is string && data.numero.size() >= 1 && data.numero.size() <= 60 &&
        data.dataEmissao is string && data.dataEmissao.size() >= 8 && data.dataEmissao.size() <= 20 &&
        data.valor is number && data.valor > 0 &&
        data.descricao is string && data.descricao.size() >= 3 && data.descricao.size() <= 1000 &&
        (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 1000)) &&
        (!('prestadorEmpresa' in data) || (data.prestadorEmpresa is string && data.prestadorEmpresa.size() <= 180)) &&
        (!('prestadorFuncao' in data) || (data.prestadorFuncao is string && data.prestadorFuncao.size() <= 120)) &&
        (!('arquivoPath' in data) || (data.arquivoPath is string && data.arquivoPath.size() <= 500)) &&
        (!('arquivoNome' in data) || (data.arquivoNome is string && data.arquivoNome.size() <= 250)) &&
        data.status in ['Emitida', 'Aguardando comprovante', 'Comprovada'] &&
        data.criadoPorUid is string && data.criadoPorUid.size() <= 128 &&
        data.criadoPorNome is string && data.criadoPorNome.size() >= 2 && data.criadoPorNome.size() <= 150;
    }

    function isValidComprovante(data) {
      return data.keys().hasAll([
          'notaId', 'prestadorId', 'descricao', 'data', 'arquivoPath',
          'tipo', 'tamanho', 'criadoPorUid', 'criadoPorNome', 'criadoEm'
        ]) &&
        data.keys().hasOnly([
          'notaId', 'prestadorId', 'categoria', 'valor', 'descricao', 'data', 'arquivoPath', 'arquivoNome',
          'tipo', 'tamanho', 'criadoPorUid', 'criadoPorNome', 'criadoEm'
        ]) &&
        isValidId(data.notaId) &&
        isValidId(data.prestadorId) &&
        (!('categoria' in data) || data.categoria in ['Hospedagem', 'Combustível', 'Alimentação', 'Almoço', 'Pedágios', 'Estacionamento', 'Outras despesas']) &&
        (!('valor' in data) || (data.valor is number && data.valor >= 0)) &&
        data.descricao is string && data.descricao.size() >= 2 && data.descricao.size() <= 500 &&
        data.data is string && data.data.size() >= 8 && data.data.size() <= 20 &&
        data.arquivoPath is string && data.arquivoPath.size() >= 1 && data.arquivoPath.size() <= 500 &&
        (!('arquivoNome' in data) || (data.arquivoNome is string && data.arquivoNome.size() <= 250)) &&
        data.tipo in ['application/pdf', 'image/jpeg', 'image/png'] &&
        data.tamanho is number && data.tamanho > 0 && data.tamanho <= 10485760 &&
        data.criadoPorUid is string && data.criadoPorUid.size() <= 128 &&
        data.criadoPorNome is string && data.criadoPorNome.size() >= 2 && data.criadoPorNome.size() <= 150;
    }

    function isValidAuditoria(data) {
      return data.keys().hasAll(['acao', 'entidade', 'entidadeId', 'autorUid', 'autorNome', 'autorRole', 'criadoEm']) &&
        data.keys().hasOnly(['acao', 'entidade', 'entidadeId', 'detalhes', 'autorUid', 'autorNome', 'autorRole', 'criadoEm']) &&
        data.acao is string && data.acao.size() >= 2 && data.acao.size() <= 120 &&
        data.entidade in ['cadastro', 'nota', 'comprovante', 'usuario', 'solicitacao'] &&
        data.entidadeId is string && data.entidadeId.size() >= 1 && data.entidadeId.size() <= 128 &&
        (!('detalhes' in data) || (data.detalhes is string && data.detalhes.size() <= 1000)) &&
        data.autorUid is string && data.autorUid == request.auth.uid &&
        data.autorNome is string && data.autorNome.size() >= 2 && data.autorNome.size() <= 150 &&
        data.autorRole is string && data.autorRole.size() <= 50 &&
        data.criadoEm == request.time;
    }

    // ==================== COLEÇÕES ====================

    match /usuarios/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if isValidId(uid) && admin() && isValidUsuario(incoming());
      allow update: if isValidId(uid) && isValidUsuario(incoming()) && (
        admin() ||
        (request.auth.uid == uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['isFirstLogin']) &&
         incoming().role == existing().role &&
         incoming().ativo == existing().ativo)
      );
      allow delete: if isValidId(uid) && admin();
    }

    // cadastros: formulário público cria com exatos 16 campos; leitura por acessoFluxoEquipes(); update e delete apenas admin() (Financeiro & Coordenação)
    match /cadastros/{id} {
      allow get: if isValidId(id) && acessoFluxoEquipes();
      allow list: if acessoFluxoEquipes();
      allow create: if isValidId(id) && isValidCadastroPublicoCreate(incoming());
      allow update: if isValidId(id) && admin() && isValidCadastroUpdate(incoming()) &&
        incoming().criadoEm == existing().criadoEm;
      allow delete: if isValidId(id) && admin();
    }

    match /notas/{id} {
      allow get: if isValidId(id) && acessoFluxoEquipes();
      allow list: if acessoFluxoEquipes();
      allow create: if isValidId(id) && (eNota() || admin()) &&
        isValidNota(incoming()) &&
        incoming().criadoPorUid == request.auth.uid &&
        incoming().criadoEm == request.time &&
        incoming().atualizadoEm == request.time &&
        incoming().status == 'Emitida' &&
        exists(/databases/$(database)/documents/cadastros/$(incoming().prestadorId));
      allow update: if isValidId(id) && isValidNota(incoming()) &&
        incoming().criadoEm == existing().criadoEm &&
        incoming().criadoPorUid == existing().criadoPorUid &&
        incoming().atualizadoEm == request.time && (
          admin() ||
          (eNota() && existing().criadoPorUid == request.auth.uid &&
           existing().status == 'Emitida' &&
           incoming().status in ['Emitida', 'Aguardando comprovante']) ||
          (eComp() &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'atualizadoEm']) &&
           existing().status in ['Emitida', 'Aguardando comprovante', 'Comprovada'] &&
           incoming().status == 'Comprovada')
        );
      allow delete: if isValidId(id) && admin();
    }

    match /comprovantes/{id} {
      allow get: if isValidId(id) && acessoFluxoEquipes();
      allow list: if acessoFluxoEquipes();
      allow create: if isValidId(id) && (eComp() || admin()) &&
        isValidComprovante(incoming()) &&
        incoming().criadoPorUid == request.auth.uid &&
        incoming().criadoEm == request.time &&
        exists(/databases/$(database)/documents/notas/$(incoming().notaId));
      allow update: if false;
      allow delete: if isValidId(id) && admin();
    }

    match /auditoria/{id} {
      allow get: if isValidId(id) && interno();
      allow list: if interno();
      allow create: if isValidId(id) && interno() && isValidAuditoria(incoming());
      allow update: if false;
      allow delete: if false;
    }

    match /test/{docId} {
      allow get: if isSignedIn();
    }
  }
}
