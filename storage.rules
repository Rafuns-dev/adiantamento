rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bloqueio global por padrão (sem acesso anônimo)
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function tamanhoValido() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024; // Máximo 15 MB
    }

    function tipoNotaValido() {
      return request.resource.contentType in [
        'application/pdf',
        'application/xml',
        'text/xml',
        'image/jpeg',
        'image/jpg',
        'image/png',
        'image/webp'
      ];
    }

    function tipoComprovanteValido() {
      return request.resource.contentType in [
        'application/pdf',
        'image/jpeg',
        'image/jpg',
        'image/png',
        'image/webp'
      ];
    }

    // Notas Fiscais: notas/{notaId}/{arquivo}
    // Obs.: o Firestore do app usa um banco nomeado (não "(default)"), portanto
    // regras do Storage validam autenticação ativa, tipo e tamanho diretamente.
    match /notas/{notaId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && tamanhoValido() && tipoNotaValido();
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // Comprovantes: comprovantes/{notaId}/{arquivo}
    match /comprovantes/{notaId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && tamanhoValido() && tipoComprovanteValido();
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // Solicitações (NFs, comprovantes e recibos): solicitacoes/{requestId}/{fileName}
    match /solicitacoes/{requestId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && tamanhoValido();
      allow update: if false;
      allow delete: if isSignedIn();
    }
  }
}
